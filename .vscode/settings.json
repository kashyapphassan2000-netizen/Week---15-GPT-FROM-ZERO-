{
  "python.defaultInterpreterPath": ".venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/wandb": true,
    "**/data/raw": true,
    "**/data/tokens": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
